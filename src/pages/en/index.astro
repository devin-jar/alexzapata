---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Button from '~/components/ui/Button.astro';
import { getTranslator, defaultLang, supportedLangs } from '~/i18n';
import { getPageKeyForPath, getAlternateLinksForPage as getAlternateLinks } from '~/utils/hreflang-mapping';
import type { MetaData } from '~/types';

interface JsonModule { default?: Record<string, any>; [key: string]: any; }

const currentLocale = Astro.currentLocale && supportedLangs.includes(Astro.currentLocale)
  ? Astro.currentLocale
  : defaultLang;

const translationModules = import.meta.glob('~/i18n/locales/**/translation.json', { eager: true }) as Record<string, JsonModule | undefined>;
const moduleCandidate = translationModules[`/src/i18n/locales/${currentLocale}/translation.json`];
const pageTranslations = moduleCandidate ? moduleCandidate.default || moduleCandidate : {};
const t = getTranslator(pageTranslations, currentLocale);

const whatsappBaseLink = 'https://api.whatsapp.com/send/?phone=573004481819&type=phone_number&app_absent=0';
const whatsappLink = `${whatsappBaseLink}&text=${encodeURIComponent(t('footer.social.whatsappMessage'))}`;

const heroImageSrc = 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1600&q=80';

const metadata: MetaData = {
  title: t('homepage.meta.title'),
  description: t('homepage.meta.description'),
  robots: { index: true, follow: true },
  canonical: Astro.url.href,
  type: 'website',
  openGraph: {
    title: t('homepage.meta.title'),
    description: t('homepage.meta.description'),
    type: 'website',
    locale: currentLocale === 'en' ? 'en_US' : 'es_ES',
  },
  twitter: {
    cardType: 'summary_large_image',
    title: t('homepage.meta.title'),
    description: t('homepage.meta.description'),
    imageAlt: t('homepage.hero.imageAlt'),
  },
  ...(getPageKeyForPath(Astro.url.pathname, currentLocale)
    ? { alternateLinks: getAlternateLinks(getPageKeyForPath(Astro.url.pathname, currentLocale), currentLocale) }
    : {}),
};

const heroData = {
  tagline: t('homepage.hero.tagline'),
  title: t('homepage.hero.title'),
  subtitle: t('homepage.hero.subtitle'),
  actions: [{ variant: 'primary', href: whatsappLink, target: '_blank', text: t('homepage.hero.actionText') }],
  note: t('homepage.heroNote'),
  image: { src: heroImageSrc, alt: t('homepage.hero.imageAlt') },
};

// Structured testimonials with country codes for flags
const testimonials = [
  {
    text: 'We came to Alex on the verge of separation. Every fight ended up being about money or lack of attention. In the first session, Alex showed us the issue was not the bank account, but a pattern of power and insecurity. He gave us practical tools to communicate without attacking. We restored connection faster than expected.',
    author: 'Carlos & María',
    country: 'US',
  },
  {
    text: 'I earned well in my business, but money literally vanished. I felt like I had a hole in my pocket. Alex helped me identify a pattern of guilt and self-sabotage I had carried for years. Today my savings are healthy and I no longer fear abundance. The session paid for itself in the first week.',
    author: 'Carolina M.',
    country: 'CA',
  },
  {
    text: "Debt stress was destroying me from the inside. The session with Alex was a cold shower, but a necessary one. He didn't judge me, he understood me and gave me a clear action plan to get out of the hole. In 60 minutes I understood why I was blocking myself from making more income.",
    author: 'Ricardo V.',
    country: 'MX',
  },
];

const countryFlag = { US: '🇺🇸', CA: '🇨🇦', MX: '🇲🇽' };

---

<Layout metadata={metadata}>
  <Hero {...heroData} />

  <section class="bg-slate-50 dark:bg-slate-900 py-20 px-6">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-slate-900 dark:text-white">{t('homepage.pain.title')}</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <article class="rounded-3xl bg-white p-8 shadow-sm border border-slate-200">
          <h3 class="text-2xl font-semibold text-red-600 mb-4">{t('homepage.pain.couples.title')}</h3>
          <p class="text-slate-600 leading-relaxed">{t('homepage.pain.couples.description')}</p>
        </article>
        <article class="rounded-3xl bg-white p-8 shadow-sm border border-slate-200">
          <h3 class="text-2xl font-semibold text-red-600 mb-4">{t('homepage.pain.money.title')}</h3>
          <p class="text-slate-600 leading-relaxed">{t('homepage.pain.money.description')}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{t('homepage.solution.title')}</h2>
      <p class="text-lg text-slate-600 dark:text-slate-300 mb-12">{t('homepage.solution.subtitle')}</p>
      <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm uppercase tracking-[0.24em] text-emerald-600">Real testimonials</p>
        <h2 class="text-3xl md:text-4xl font-bold mt-4 text-slate-900 dark:text-white">Stories from clients</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">Voices of couples and entrepreneurs who found emotional clarity and financial progress in practical sessions.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-3">
        {testimonials.map((it) => (
          <article class="rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-8 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col">
            <div class="mb-4 text-2xl">❝ <span class="text-emerald-600">⭐⭐⭐⭐⭐</span></div>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">{it.text}</p>
            <p class="mt-auto font-semibold text-slate-900 dark:text-white">{it.author} <span class="ml-2">{countryFlag[it.country]}</span></p>
          </article>
        ))}
      </div>
    </div>
    </div>
  </section>

  <!-- CTA section separated -->
  <section class="bg-slate-50 dark:bg-slate-900 py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-sm text-emerald-600 uppercase tracking-[0.16em]">{t('homepage.cta.heading')}</p>
      <h3 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">{t('homepage.cta.title')}</h3>
      <div class="mt-8">
        <Button
          variant="primary"
          href={whatsappLink}
          target="_blank"
          text={t('homepage.hero.actionText')}
          class="rounded-full px-10 py-4 text-lg"
        />
      </div>
    </div>
  </section>

  

  <div class="fixed bottom-4 right-4 z-50 block sm:hidden">
    <Button
      variant="primary"
      href={whatsappLink}
      target="_blank"
      aria-label={t('homepage.hero.actionText')}
      text=""
      icon="tabler:brand-whatsapp"
      class="rounded-full p-4 shadow-2xl"
    />
  </div>
</Layout>
